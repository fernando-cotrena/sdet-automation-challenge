{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022", "DOM"],
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@support/*": ["cypress/support/*"],
      "@services/*": ["cypress/services/*"],
      "@schemas/*": ["cypress/schemas/*"],
      "@factories/*": ["cypress/factories/*"],
      "@pages/*": ["cypress/pages/*"]
    },
    "types": ["cypress", "node"]
  },
  "include": ["cypress/**/*.ts", "cypress.config.ts"]
}
